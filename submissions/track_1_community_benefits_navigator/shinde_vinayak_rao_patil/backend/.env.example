# OpenRouter API Configuration (for Nemotron-3-Super)
API_KEY=sk-or-v1-your_key_here
API_URL=https://openrouter.ai/api/v1
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free

# Optional: app identity sent to OpenRouter
APP_URL=https://github.com/shindevrp/meetup-nvidia-nemotron-3-super
APP_TITLE=Community Benefits Navigator

# Server Configuration
HOST=0.0.0.0
PORT=8000
RATE_LIMIT=30

# Security
CORS_ORIGINS=*

# Admin key (set a random string to enable POST /api/admin/refresh)
# Generate one: openssl rand -hex 16
ADMIN_KEY=change-me-to-a-secret-key
